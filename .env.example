
# ============================================================
# Workzeno - Local Docker Compose configuration
# LOCAL DEVELOPMENT ONLY
# Never use these values in production.
# ============================================================

# PostgreSQL container
POSTGRES_DB=workzeno
POSTGRES_USER=workzeno
POSTGRES_PASSWORD=workzeno-local-db-password
POSTGRES_PORT=5432

# Backend datasource
# Docker Compose uses the service name "db", not localhost.
DB_URL=jdbc:postgresql://db:5432/workzeno
DB_USERNAME=workzeno
DB_PASSWORD=workzeno-local-db-password

# Backend security
# 32 decoded bytes (256 bits), for local development only.
# Generate a separate random secret for production.
JWT_SECRET_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Refresh cookie
# Local HTTP development does not use Secure cookies.
REFRESH_COOKIE_SECURE=false

# API documentation
OPENAPI_ENABLED=true

# Bootstrap administrator
# Disabled by default. Enable deliberately only if needed locally.
WORKZENO_BOOTSTRAP_ADMIN_ENABLED=false
WORKZENO_BOOTSTRAP_ADMIN_EMAIL=
WORKZENO_BOOTSTRAP_ADMIN_PASSWORD=

# Backend runtime
SERVER_PORT=8080
