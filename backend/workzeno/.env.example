
# ============================================================
# Workzeno backend - Direct local development
# Used when running Spring Boot outside Docker.
# ============================================================

# PostgreSQL running on the local machine
DB_URL=jdbc:postgresql://localhost:5432/workzeno
DB_USERNAME=workzeno
DB_PASSWORD=workzeno-local-db-password

# Authentication
JWT_SECRET_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Frontend origin
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Refresh cookie
REFRESH_COOKIE_SECURE=false

# API documentation
OPENAPI_ENABLED=true

# Bootstrap administrator
WORKZENO_BOOTSTRAP_ADMIN_ENABLED=false
WORKZENO_BOOTSTRAP_ADMIN_EMAIL=
WORKZENO_BOOTSTRAP_ADMIN_PASSWORD=
